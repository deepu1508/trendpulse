<Display>:


    FloatLayout:

        Label:
            id:class_details
            size_hint: 0.5, 0.12
            pos_hint: {"x":0, "top":0.7}
            font_size: (root.width**2 + root.height**2) / 14**4


        Spinner:

            id: spinner_id
            text:"select class"
            values: ["1", "2", "3", "4", "5"]
            size_hint: None, None
            size: 200, 50
            pos_hint:{'center_x':.5, 'top': 0.9}
            on_text: root.spinner_clicked(spinner_id.text)

        Button:
            pos_hint:{"x":0.3,"top":0.2}
            size_hint: 0.3, 0.12
            text: "back"
            font_size: (root.width**2 + root.height**2) / 14**4
            on_release:
                root.manager.transition.direction = "left"
                root.back1()

