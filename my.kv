

<CreateAccountWindow>:
    name: "create"

    namee: namee
    email: email
    password: passw

    FloatLayout:
        cols:1

        FloatLayout:
            size: root.width, root.height/2

            Label:
                text: "Create an Account"
                color:(1,0,0,1)
                size_hint: 0.8, 0.2
                pos_hint: {"x":0.1, "top":1}
                font_size: (root.width**2 + root.height**2) / 14**4


            Label:
                size_hint: 0.5,0.12
                pos_hint: {"x":0, "top":0.8}
                text: "School Name: "
                color:(0,0,1,1)
                font_size: (root.width**2 + root.height**2) / 14**4

            TextInput:
                pos_hint: {"x":0.5, "top":0.8}
                size_hint: 0.4, 0.12
                id: namee
                multiline: False
                font_size: (root.width**2 + root.height**2) / 14**4

            Label:
                size_hint: 0.5,0.12
                pos_hint: {"x":0, "top":0.8-0.13}
                text: "user name:"
                color:(0,0,1,1)
                font_size: (root.width**2 + root.height**2) / 14**4

            TextInput:
                pos_hint: {"x":0.5, "top":0.8-0.13}
                size_hint: 0.4, 0.12
                id: email
                multiline: False
                font_size: (root.width**2 + root.height**2) / 14**4

            Label:
                size_hint: 0.5,0.12
                pos_hint: {"x":0, "top":0.8-0.13*2}
                text: "Password: "
                color:(0,0,1,1)
                font_size: (root.width**2 + root.height**2) / 14**4

            TextInput:
                pos_hint: {"x":0.5, "top":0.8-0.13*2}
                size_hint: 0.4, 0.12
                id: passw
                multiline: False
                password: True
                font_size: (root.width**2 + root.height**2) / 14**4

        Button:
            pos_hint:{"x":0.2,"y":0.1}
            size_hint: 0.5, 0.1
            font_size: (root.width**2 + root.height**2) / 15**4
            text: "Already have an Account? Log In"
            color:(1,0,0,1)
            on_release:
                root.manager.transition.direction = "left"
                root.login()

        Button:
            pos_hint:{"x":0.3,"y":0.25}
            size_hint: 0.3, 0.1
            text: "SUBMIT"
            color:(0,1,0,1)
            font_size: (root.width**2 + root.height**2) / 14**4
            on_release:
                root.manager.transition.direction = "left"
                root.submit()


<LoginWindow>:
    name: "login"

    email: email
    password: password

    FloatLayout:
        cols:1

        FloatLayout:
            size: root.width, root.height/2

            Label:
                text: "                                WELCOME \n ( SCHOOL FEE MANAGEMENT SYSTEM )"
                color:(1,0,0,1)
                size_hint: 0.8, 0.2
                pos_hint: {"x":0.1, "top":1}
                font_size: (root.width**2 + root.height**2) / 14**4


            Label:
                text:"user name: "
                color:(0,0,1,1)
                font_size: (root.width**2 + root.height**2) / 13**4
                pos_hint: {"x":0.1, "top":0.8}
                size_hint: 0.35, 0.1

            TextInput:
                id: email
                font_size: (root.width**2 + root.height**2) / 13**4
                multiline: False
                pos_hint: {"x": 0.45 , "top":0.8}
                size_hint: 0.4, 0.1

            Label:
                text:"Password: "
                color:(0,0,1,1)
                font_size: (root.width**2 + root.height**2) / 13**4
                pos_hint: {"x":0.1, "top":0.6}
                size_hint: 0.35, 0.1

            TextInput:
                id: password
                font_size: (root.width**2 + root.height**2) / 13**4
                multiline: False
                password: True
                pos_hint: {"x": 0.45, "top":0.6}
                size_hint: 0.4, 0.1

            Button:
                pos_hint:{"x":0.05,"y":0.3}
                size_hint: 0.4, 0.1
                font_size: (root.width**2 + root.height**2) / 13**4
                text: "LOGIN"
                color:(0,1,0,1)
                on_release:
                    root.manager.transition.direction = "up"
                    root.loginBtn()

            Button:
                pos_hint:{"x":0.5,"y":0.3}
                size_hint: 0.4, 0.1
                font_size: (root.width**2 + root.height**2) / 13**4
                text: "REGISTER"
                color:(1,0,0,1)
                on_release:
                    root.manager.transition.direction = "right"
                    root.createBtn()

